# Database (local dev — Docker provides this)
DATABASE_URL=postgresql://ruvicode:ruvicode@localhost:5432/ruvicode

# Shared Redis used by the Go gateway for the API key cache. The dashboard
# deletes apikey:{hash} here on revoke/limit change so changes apply
# immediately. Omit to rely on the gateway's 5-minute cache TTL.
REDIS_URL=redis://localhost:6379

# Better-auth
BETTER_AUTH_SECRET=          # Generate: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# OAuth (optional for MVP, but configure early)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Paddle
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox           # sandbox | production

# Resend (transactional email — ADR-014)
RESEND_API_KEY=               # re_... — optional in local dev (console.log fallback)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Playground (dedicated provider key for unauthenticated playground — NOT the main pool)
PROVIDER_PLAYGROUND_KEY=
PROVIDER_BASE_URL=https://api.example.com/v1

# Upstash (rate limiting for playground — optional in local dev)
# If not set, playground runs without rate limiting (dev only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
